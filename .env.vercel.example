# Copy values into Vercel → Project → Settings → Environment Variables
# (Production), then Redeploy. Vite bakes these in at build time.

VITE_APP_TITLE=LPay — Link Payment

# REQUIRED for Vercel: full Hostinger API base (not /api/v1).
# Replace with your real Hostinger domain.
VITE_API_BASE_URL=https://YOUR-HOSTINGER-DOMAIN/api/v1

VITE_FRONTEND_URL=https://lpayph.vercel.app
