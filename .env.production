VITE_APP_TITLE=LPay — Link Payment

# Same-origin Hostinger deploy (SPA + API on one domain):
# VITE_API_BASE_URL=/api/v1
#
# Split deploy (this SPA on Vercel → Laravel on Hostinger):
# Set this in the Vercel project Environment Variables, then redeploy.
# Example:
# VITE_API_BASE_URL=https://your-lpay-site.hostingersite.com/api/v1
VITE_API_BASE_URL=/api/v1

VITE_FRONTEND_URL=https://lpayph.vercel.app
